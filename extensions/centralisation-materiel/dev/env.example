# Configuration de développement (make run-dev). Copier en dev/env, jamais commité (.env ignoré).
IRUNDOO_ISSUER=http://local.irundoo.fr:3000
CLIENT_ID=<32 hex remis par ext:client:register>
# Le secret dans un fichier 0600, jamais en argument :
CLIENT_SECRET_FILE=./tmp/client_secret
PUBLIC_URL=http://127.0.0.1:8090
LISTEN=127.0.0.1:8090
DATA_DIR=./tmp
STALE_AFTER=2m
POLL_INTERVAL=1m
DEV_INSECURE_COOKIES=true
LOG_LEVEL=debug
