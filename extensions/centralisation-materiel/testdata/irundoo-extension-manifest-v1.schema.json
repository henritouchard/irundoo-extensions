{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:irundoo:schema:irundoo-extension-manifest:1",
  "title": "Manifeste d'extension IRUNDO, version 1",
  "description": "Format irundoo-extension-manifest v1. Spécification : irundoo-extension-manifest-v1.md. Équivalence avec App\\Services\\Extensions\\Irundoo\\IrundooManifestValidator tenue par tests/Unit/Extensions/IrundooManifestSchemaParityTest.php. Pas d'additionalProperties : un champ inconnu est ignoré (évolution additive).",
  "type": "object",
  "required": ["format", "version", "id", "name", "extension_version", "publisher", "type", "entry_url", "icon", "description"],
  "properties": {
    "format": { "const": "irundoo-extension-manifest" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "maxLength": 100, "pattern": "^[\\x20\\xA0\u1680\u2000-\u200a\u202f\u205f\u3000\u115f\u1160\u3164\uffa0\u2800]*[^\\x00-\\x1F\\x7F-\\x9F\\xAD\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\\x20\\xA0\u1680\u2000-\u200a\u202f\u205f\u3000\u115f\u1160\u3164\uffa0\u2800][^\\x00-\\x1F\\x7F-\\x9F\\xAD\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb]*$" },
    "extension_version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$" },
    "publisher": { "type": "string", "maxLength": 100, "pattern": "^[\\x20\\xA0\u1680\u2000-\u200a\u202f\u205f\u3000\u115f\u1160\u3164\uffa0\u2800]*[^\\x00-\\x1F\\x7F-\\x9F\\xAD\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\\x20\\xA0\u1680\u2000-\u200a\u202f\u205f\u3000\u115f\u1160\u3164\uffa0\u2800][^\\x00-\\x1F\\x7F-\\x9F\\xAD\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb]*$" },
    "type": { "enum": ["link", "app"] },
    "entry_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?=[A-Za-z0-9.-]{1,253}(?:[:/?#]|$))(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~!$&'()*+,;=:@/-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/-]*)*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@/?-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/?-]*)*)?(?:#[A-Za-z0-9._~!$&'()*+,;=:@/?-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/?-]*)*)?$"
    },
    "icon": { "type": "string", "maxLength": 64, "pattern": "^fa-(?:solid|regular|brands) fa-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "maxLength": 1000, "pattern": "^[\\x0A\\x20\\xA0\u1680\u2000-\u200a\u202f\u205f\u3000\u115f\u1160\u3164\uffa0\u2800]*[^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F\\xAD\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\\x0A\\x20\\xA0\u1680\u2000-\u200a\u202f\u205f\u3000\u115f\u1160\u3164\uffa0\u2800][^\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F\\xAD\u061c\u180e\u200b-\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb]*$" },
    "redirect_uris": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 2048,
        "pattern": "^(?:https://(?=[A-Za-z0-9.-]{1,253}(?:[:/?#]|$))(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)|http://(?:127\\.0\\.0\\.1|\\[::1\\]))(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~!$&'()*+,;=:@/-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/-]*)*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@/?-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/?-]*)*)?$"
      }
    },
    "health_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?=[A-Za-z0-9.-]{1,253}(?:[:/?#]|$))(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[A-Za-z0-9._~!$&'()*+,;=:@/-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/-]*)*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@/?-]*(?:%[0-9A-Fa-f]{2}[A-Za-z0-9._~!$&'()*+,;=:@/?-]*)*)?$"
    },
    "user_scopes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/scope" } },
    "machine_scopes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/scope" } }
  },
  "allOf": [
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "app" } } },
      "then": { "required": ["redirect_uris", "health_url"] }
    },
    {
      "if": { "required": ["type"], "properties": { "type": { "const": "link" } } },
      "then": { "properties": { "redirect_uris": false, "health_url": false, "user_scopes": false, "machine_scopes": false } }
    }
  ],
  "$defs": {
    "scope": { "enum": ["irundoo:perimeter:read", "irundoo:instances:read", "irundoo:objects:read", "irundoo:objects:write", "irundoo:users:read", "irundoo:users:write", "irundoo:hardware:read"] }
  }
}
